{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/mind-space/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nauryz Redkeds|Anton|Fraunces|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Nauryz Redkeds, Anton, Fraunces, Plus Jakarta Sans."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-dim",
      "--accent-hover",
      "--accent-light",
      "--accent-shadow",
      "--amber",
      "--amber-bg",
      "--backdrop",
      "--backdrop-blur",
      "--bg",
      "--border",
      "--border-strong",
      "--depth",
      "--depth-light",
      "--font-body",
      "--font-brand",
      "--font-display",
      "--font-headline",
      "--fs-2xl",
      "--fs-3xl",
      "--fs-base",
      "--fs-lg",
      "--fs-poster",
      "--fs-sm",
      "--fs-xl",
      "--fs-xs",
      "--green",
      "--green-bg",
      "--paper-grain",
      "--radius",
      "--radius-2xl",
      "--radius-lg",
      "--radius-pill",
      "--radius-sm",
      "--red",
      "--red-bg",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--space-1",
      "--space-10",
      "--space-12",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-8",
      "--surface",
      "--surface-2",
      "--surface-hover",
      "--text",
      "--text-faint",
      "--text-muted"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--surface": "color",
      "--surface-2": "color",
      "--surface-hover": "color",
      "--paper-grain": "color",
      "--border": "color",
      "--border-strong": "color",
      "--text": "font",
      "--text-muted": "font",
      "--text-faint": "font",
      "--accent": "color",
      "--accent-hover": "color",
      "--accent-dim": "color",
      "--accent-light": "color",
      "--accent-shadow": "shadow",
      "--depth": "color",
      "--depth-light": "color",
      "--amber": "color",
      "--amber-bg": "color",
      "--green": "color",
      "--green-bg": "color",
      "--red": "color",
      "--red-bg": "color",
      "--shadow-sm": "shadow",
      "--shadow-md": "shadow",
      "--shadow-lg": "shadow",
      "--radius-sm": "radius",
      "--radius": "radius",
      "--radius-lg": "radius",
      "--radius-2xl": "radius",
      "--radius-pill": "radius",
      "--font-brand": "font",
      "--font-headline": "font",
      "--font-display": "font",
      "--font-body": "font",
      "--fs-xs": "spacing",
      "--fs-sm": "spacing",
      "--fs-base": "spacing",
      "--fs-lg": "spacing",
      "--fs-xl": "spacing",
      "--fs-2xl": "spacing",
      "--fs-3xl": "spacing",
      "--fs-poster": "spacing",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
      "--space-8": "spacing",
      "--space-10": "spacing",
      "--space-12": "spacing",
      "--backdrop": "color",
      "--backdrop-blur": "spacing"
    },
    "fontFamilies": [
      "Anton",
